{#
    Falak Cart master layout — required by every theme.
    Structure check enforces: hook('head:end') + hook('body:end').

    Shared globals available in all views (see config/theme-context.php):
    | store    | store.name, store.logo, store.url, store.settings.*         |
    | theme    | theme.settings.get(key, default), theme.color.*, theme.is_rtl |
    | menus    | menus.main_menu, menus.footer_menu                           |
    | page     | page.slug, page.title                                        |
    | user     | user.language.code                                           |
#}
<!DOCTYPE html>
<html lang="{{ user.language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% hook 'head:start' %}

    <title>{% block title %}{{ store.name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ store.name }}{% endblock %}">

    {% block styles %}{% endblock %}
    {# ?v= busts browser caches from before the dev no-cache header; bump on asset changes #}
    <link rel="stylesheet" href="{{ 'styles/app.css'|asset }}?v=8">

    <style>
        :root {
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(12) }};
            --color-primary-light: {{ theme.color.lighter(12) }};
            {# theme.color.text is the CONTRAST color for primary surfaces
               (near-white when primary is dark) — never the body text color. #}
            --color-on-primary: {{ theme.color.text }};
            --font-main: '{{ theme.font.name }}';
        }

        /*
         * Dropdown state lives inline (style here, behavior at body end):
         * the HTML is generated per-request and can never be stale, so the
         * closed-by-default state always ships with the markup it controls.
         */
        .main-menu__submenu { display: none; }
        .main-menu__item.is-open > .main-menu__submenu { display: flex; }
    </style>

    {# platform injections: custom CSS, tracking, content protection #}
    {% hook 'head:end' %}
</head>
<body class="theme-falak {% hook 'body:classes' %}{{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}{{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : '' }}">
    {% hook 'body:start' %}

    <a class="skip-link" href="#main-content">{{ trans('common.skip_to_content') }}</a>

    <div class="app-inner">
        {% component 'header.header' %}

        <main id="main-content" role="main">
            {% block content %}{% endblock %}
        </main>

        {% component 'footer.footer' %}
    </div>

    {# platform injection: FalakSDK script + init #}
    {% hook 'body:end' %}

    {# Dropdown behavior — inline so it always matches this page's markup. #}
    <script>
    (function () {
        function closeAll(except) {
            document.querySelectorAll('.main-menu__item.is-open').forEach(function (item) {
                if (item !== except) item.classList.remove('is-open');
            });
        }

        document.addEventListener('click', function (event) {
            var link = event.target.closest('.main-menu__item.has-children > a');

            if (link) {
                event.preventDefault();
                var item = link.parentElement;
                closeAll(item);
                item.classList.toggle('is-open');
                return;
            }

            if (!event.target.closest('.main-menu')) closeAll(null);
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeAll(null);
        });
    })();
    </script>

    <script defer src="{{ 'js/app.js'|asset }}?v=8"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
