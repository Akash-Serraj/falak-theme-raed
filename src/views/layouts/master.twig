{#
    Falak Cart master layout — required by every theme.
    Structure check enforces: hook('head:end') + hook('body:end').

    Shared globals available in all views (see config/theme-context.php):
    | store    | store.name, store.logo, store.favicon, store.url, store.settings.* |
    | theme    | theme.settings.get(key, default), theme.color.*, theme.is_rtl |
    | menus    | menus.main_menu, menus.footer_menu                           |
    | page     | page.slug, page.title                                        |
    | user     | user.language.code                                           |

    {% hook 'body:end' %} also carries the customizer's editor bridge in draft
    renders. Dropping the hook does not merely lose the platform SDK — it
    silently turns off click-to-edit in the merchant's preview.
#}
<!DOCTYPE html>
<html lang="{{ user.language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% hook 'head:start' %}

    {#
        Breadcrumb trail is cached per session by <falak-breadcrumb>, titles
        included, so a trail built in one language survives a switch to the
        other. Dropped here — before the SDK loads — so the component rebuilds
        it in the language actually being read.
    #}
    <script>
        (function () {
            try {
                var locale = document.documentElement.lang || '';
                var seen = window.sessionStorage.getItem('falak::breadcrumb.locale');

                if (seen !== null && seen !== locale) {
                    window.sessionStorage.removeItem('falak::breadcrumb.trail');
                }

                window.sessionStorage.setItem('falak::breadcrumb.locale', locale);
            } catch (e) {
                /* Private mode and blocked storage both throw; the breadcrumb
                   simply keeps whatever it had. */
            }
        })();
    </script>

    <title>{% block title %}{{ seo.title }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{{ seo.description }}{% endblock %}">

    {% if store.favicon %}
        <link rel="icon" href="{{ store.favicon }}">
    {% endif %}

    {% block styles %}{% endblock %}
    {# ?v= busts browser caches from before the dev no-cache header; bump on asset changes #}
    <link rel="stylesheet" href="{{ 'styles/app.css'|asset }}?v=54">

    <style>
        :root {
            {# Only when the merchant picked a brand colour. Otherwise app.css
               already carries the theme's own palette (the platform reads its
               --color-primary from there), including shades darker()/lighter()
               would not reproduce. #}
            {% if theme.color.source == 'store' %}
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(12) }};
            --color-primary-light: {{ theme.color.lighter(12) }};
            {# theme.color.text is the CONTRAST color for primary surfaces
               (near-white when primary is dark) — never the body text color. #}
            --color-on-primary: {{ theme.color.text }};
            {% endif %}
            --font-main: 'Falak Riyal', '{{ theme.font.name }}';

            {# Merchant background colours (customizer -> Colors group).
               Emitted ONLY when set: an unset value must fall through to the
               theme's own default, including the dark header/footer presets,
               rather than being pinned to whatever white happened to be. #}
            {% if theme.settings.get('body_bg_color') %}
            --color-bg: {{ theme.settings.get('body_bg_color') }};
            {% endif %}
            {% if theme.settings.get('header_bg_color') %}
            --color-header-bg: {{ theme.settings.get('header_bg_color') }};
            {% endif %}
            {% if theme.settings.get('footer_bg_color') %}
            --color-footer-bg: {{ theme.settings.get('footer_bg_color') }};
            {% endif %}
        }
        /*
         * Page loader.
         *
         * Covers the viewport from first paint until the page is ready, so a
         * slow connection sees a spinner rather than a white screen and
         * half-styled content assembling itself.
         *
         * Removed by the inline script at the end of <body>, which is also what
         * makes this safe: the class that hides it is added on `load`, and a
         * timeout takes it away regardless, so a stalled asset can never leave
         * a shopper staring at a permanent overlay.
         */
        .page-loader {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            background: var(--color-bg, #fff);
            transition: opacity 0.35s ease, visibility 0.35s ease;
        }

        .page-loader__spinner {
            inline-size: 2.25rem;
            block-size: 2.25rem;
            border: 3px solid color-mix(in srgb, var(--color-primary, #101631) 20%, transparent);
            border-block-start-color: var(--color-primary, #101631);
            border-radius: 50%;
            animation: page-loader-spin 0.7s linear infinite;
        }

        @keyframes page-loader-spin { to { transform: rotate(360deg); } }

        /* Gone from the accessibility tree as well as the screen: a hidden
           overlay that still answers to the screen reader is worse than none. */
        .page-loader.is-done {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        /* The spin is decoration; the overlay still does its job without it. */
        @media (prefers-reduced-motion: reduce) {
            .page-loader__spinner { animation-duration: 2.4s; }
            .page-loader { transition: none; }
        }
    </style>

    {# platform injections: custom CSS, tracking, content protection #}
    {% hook 'head:end' %}
</head>
<body class="theme-falak {% hook 'body:classes' %}{{ theme.settings.get('topnav_is_dark') ? ' topnav-is-dark' : '' }}{{ theme.settings.get('footer_is_dark') ? ' footer-is-dark' : '' }}">
    {% hook 'body:start' %}

    {#
        A spinner while the page loads. First element in the body and
        styled from the head's inline CSS, so it is on screen before the
        stylesheet, the SDK or this theme's JS have arrived — which is the whole
        point of it, and the reason it is not <falak-loading>: that is a custom
        element and paints nothing until its bundle upgrades it.
    #}
    {% if theme.settings.get('page_loader_enabled', true) %}
        <div class="page-loader" id="page-loader" role="status" aria-live="polite"
             aria-label="{{ trans('common.loading') }}">
            <span class="page-loader__spinner" aria-hidden="true"></span>
        </div>
    {% endif %}

    <a class="skip-link" href="#main-content">{{ trans('common.skip_to_content') }}</a>

    <div class="app-inner">
        {% component 'header.header' %}

        <main id="main-content" role="main">
            {% block content %}{% endblock %}
        </main>

        {% component 'footer.footer' %}
    </div>

    {# Placed once for the whole storefront. The login sheet opens itself on
       `auth::required`, which is what falak.auth.requireLoginThen() dispatches
       — so no gated action needs a reference to it. #}
    <falak-login-modal></falak-login-modal>

    {# The "added to your cart" card: listens to cart::added, so every add
       button on the page (lists, quick-add, product page) uses it. #}
    <falak-add-product-toast cart-url="/cart" checkout-url="/checkout"></falak-add-product-toast>

    {# The platform's own toast stack (validation errors, "coupon applied",
       anything falak.notify fires) — top corner, so it never collides with
       the add-to-cart card above. app.js stops routing its own bridge here
       when it sees this element, so a message never shows twice. #}
    <falak-notifications position="top-end"></falak-notifications>

    {# platform injection: FalakSDK script + init #}
    {% hook 'body:end' %}

    {#
        Take the loader away when the page is ready.

        Inline and NOT deferred, so it runs even if app.js never arrives — the
        overlay covers the viewport, and an overlay whose removal depends on a
        file that failed to download is a broken store, not a slow one. Three
        ways out, whichever comes first:

          load      the honest one — stylesheet, fonts and images are in
          2.5s      a cap, so a single stalled asset cannot hold the page
          pageshow  bfcache restores the DOM as it was, overlay and all, so a
                    back-button return has to clear it again

        The class fades it out and the node is removed after, because a
        permanently-fixed element keeps intercepting nothing but still sits in
        the accessibility tree.
    #}
    <script>
        (function () {
            var loader = document.getElementById('page-loader');
            if (!loader) return;

            var done = false;

            function dismiss() {
                if (done) return;
                done = true;

                loader.classList.add('is-done');
                setTimeout(function () { loader.remove(); }, 400);
            }

            if (document.readyState === 'complete') dismiss();
            else window.addEventListener('load', dismiss);

            setTimeout(dismiss, 2500);
            window.addEventListener('pageshow', function (e) { if (e.persisted) dismiss(); });
        })();
    </script>

    <script defer src="{{ 'js/app.js'|asset }}?v=24"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
