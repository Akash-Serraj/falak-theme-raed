        "en": "All Categories"
    },
    "icon": "grid-line",
    "is_default": true,
    "default_sort": 20,
    "areas": ["home", "pages"],
    "styleable": [
        { "id": "title", "label": { "ar": "العنوان", "en": "Title" } },
        { "id": "subtitle", "label": { "ar": "العنوان الفرعي", "en": "Subtitle" } }
    ],
    "fields": [
        {
            "id": "title",
            "type": "string",
