            "id": "title",
            "label": {
                "ar": "عنوان القسم",
                "en": "Section title"
            }
        },
        {
            "id": "items",
            "label": {
                "ar": "البطاقة",
                "en": "Card"
            },
            "properties": [
                "max_width",
                "align_self",
                "text_align",
                "padding_block",
                "padding_inline",
                "background_color",
                "border_radius",
                "border_width",
                "border_color"
            ]
        },
        {
            "id": "stars",
            "label": {
                "ar": "النجوم",
                "en": "Stars"
            },
            "properties": [
                "font_size",
                "color",
                "text_align"
            ]
        },
        {
            "id": "quote",
            "label": {
                "ar": "الاقتباس",
                "en": "Quote"
            }
        },
        {
            "id": "author",
            "label": {
                "ar": "الكاتب",
                "en": "Author"
            }
        }
    ],
    "fields": [
        {
            "id": "title",
            "type": "string",
            "format": "text",
            "label": {
                "ar": "العنوان",
                "en": "Title"
            },
            "multilanguage": true,
            "required": false,
            "maxLength": 100,
            "value": {
                "ar": "آراء عملائنا",
                "en": "What our customers say"
            }
        },
        {
            "id": "show_stars",
            "type": "boolean",
            "format": "switch",
            "label": {
                "ar": "إظهار التقييم بالنجوم",
                "en": "Show star ratings"
            },
            "description": {
                "ar": "إخفاؤها يعرض الاقتباسات فقط.",
                "en": "Turning this off shows the quotes on their own."
            },
            "value": true
        },
        {
            "id": "source",
            "type": "items",
            "format": "dropdown-list",
            "label": {
                "ar": "المصدر",
                "en": "Source"
            },
            "description": {
                "ar": "التقييمات الحقيقية تُجلب من تقييمات العملاء المعتمدة",
                "en": "Real reviews are pulled from your approved customer reviews"
            },
            "value": "manual",
            "options": [
                {
                    "label": {
                        "ar": "تقييمات المتجر الحقيقية",
                        "en": "Real store reviews"
                    },
                    "value": "reviews"
                },
                {
                    "label": {
                        "ar": "آراء مكتوبة يدوياً",
                        "en": "Manually written"
                    },
                    "value": "manual"
                }
            ]
        },
        {
            "id": "limit",
            "type": "number",
            "format": "integer",
            "label": {
                "ar": "عدد الآراء",
                "en": "How many"
            },
            "required": false,
            "min": 2,
            "max": 12,
            "value": 6,
            "description": {
                "ar": "عدد التقييمات الحقيقية المعروضة في الشبكة",
                "en": "How many real reviews the grid shows"
            }
        },
        {
            "id": "items",
            "type": "collection",
            "format": "collection",
            "label": {
                "ar": "التقييمات",
                "en": "Reviews"
            },
            "item_label": {
                "ar": "تقييم",
                "en": "Review"
            },
            "required": false,
            "minLength": 1,
            "maxLength": 30,
            "value": [
                {
                    "items.name": "ندى الحسيني",
                    "items.stars": 5,
                    "items.text": {
                        "ar": "تجربة تسوق رائعة وسرعة في التوصيل ❤️",
                        "en": "Amazing shopping experience and fast delivery ❤️"
                    }
                },
                {
                    "items.name": "خالد الأحمد",
                    "items.stars": 5,
                    "items.text": {
                        "ar": "منتجات عالية الجودة وتعامل راقٍ 👏",
                        "en": "High quality products and great service 👏"
                    }
                }
            ],
            "fields": [
                {
                    "id": "items.name",
                    "type": "string",
                    "format": "text",
                    "label": {
                        "ar": "اسم العميل",
                        "en": "Customer name"
                    },
                    "required": true,
                    "maxLength": 80
                },
                {
                    "id": "items.stars",
                    "type": "number",
                    "format": "integer",
                    "label": {
                        "ar": "عدد النجوم",
                        "en": "Stars"
                    },
                    "value": 5,
                    "minimum": 1,
                    "maximum": 5,
                    "conditions": [
                        {
                            "id": "show_stars",
                            "value": true
                        }
                    ]
                },
                {
                    "id": "items.text",
                    "type": "string",
                    "format": "textarea",
                    "label": {
                        "ar": "نص التقييم",
                        "en": "Review text"
                    },
                    "multilanguage": true,
                    "required": true,
                    "maxLength": 255
                }
            ]
        }
    ]
}
