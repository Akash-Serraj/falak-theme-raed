{
    "key": "falak-contact",
    "path": "home.contact",
    "title": {
        "ar": "نموذج التواصل",
        "en": "Contact Form"
    },
    "icon": "mail-line",
    "is_default": false,
    "areas": ["home", "pages"],
    "styleable": [
        { "id": "title", "label": { "ar": "العنوان", "en": "Title" } },
        { "id": "subtitle", "label": { "ar": "العنوان الفرعي", "en": "Subtitle" } }
    ],
    "fields": [
        {
            "id": "title",
            "type": "string",
            "format": "text",
            "label": { "ar": "عنوان القسم", "en": "Section title" },
            "multilanguage": true,
            "required": false,
            "maxLength": 100,
            "value": { "ar": "تواصل معنا", "en": "Get in touch" }
        },
        {
            "id": "subtitle",
            "type": "string",
            "format": "text",
            "label": { "ar": "نص فرعي", "en": "Subtitle" },
            "multilanguage": true,
            "required": false,
            "maxLength": 140,
            "value": { "ar": "سنرد عليك في أقرب وقت", "en": "We will get back to you shortly" }
        },
        {
            "id": "image",
            "type": "string",
            "format": "image",
            "label": { "ar": "صورة جانبية", "en": "Side image" },
            "required": false
        },
        {
            "id": "show_subject",
            "type": "boolean",
            "format": "switch",
            "label": { "ar": "إظهار حقل الموضوع", "en": "Show the subject field" },
            "value": true
        }
    ]
}
