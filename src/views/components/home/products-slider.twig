{#
    Products carousel — merchant-placeable.

    The grid sibling (home.products) and this one differ only in how they lay
    the same cards out, so both delegate to platform components rather than
    duplicating card markup: <falak-products-slider> fetches, and hands each
    product to <falak-product-card> inside a <falak-slider>.

    | Variable              | Type    | Description                          |
    | component.title       | ?string | section title, localized server-side |
    | component.source      | ?string | which products, and in what order    |
    | component.limit       | ?int    | how many products to fetch           |
    | component.slides      | ?string | slides visible on desktop            |
    | component.category    | ?string | category id, when the source is one  |
    | component.autoplay    | ?bool   | advance on a timer                   |
    | component.show_all    | ?bool   | "view all" link, default on — opens  |
    |                       |         | the listing filtered/sorted to match |
    |                       |         | the source; only shown when more     |
    |                       |         | than 8 products match                |
    | position              | int     |                                      |

    Customizer bindings — full rules in README, "Customizer annotations".
    | Element         | Tag                      |
    | h2.block__title | data-falak-field="title" |

    The title lives on the component rather than in this template, because the
    slider renders its own header row alongside the arrows. It is tagged for the
    customizer all the same.

    The `heading` styleable role has no element: <falak-products-slider>
    renders its own title, so the role reaches it through the --falak-el-*
    custom properties, read back in app.css under "Customizer style hooks".
#}
{# "A specific category" is only meaningful with a category behind it: the
   component warns and renders nothing when the value is missing, so a source
   left half-filled falls back to the latest products rather than an empty row. #}
{% set source = component.source|default('latest') %}
{% set source = source == 'category' and not component.category ? 'latest' : source %}
<section class="block block--products-slider" id="products-slider-{{ position }}" {{ falak_section() }}>
    <div class="container">
        <falak-products-slider
            empty-message="{{ trans('product.none_added') }}"
            data-falak-field="title"
            data-falak-label="{{ trans('editor.field.title') }}"
            data-falak-bind="none"
            block-title="{{ component.title }}"
            source="{{ source }}"
            {% if source == 'category' %}source-value="{{ component.category }}"{% endif %}
            limit="{{ component.limit|default(10) }}"
            slides-per-view="{{ component.slides|default(4) }}"
            {# Autoplay implies loop: without it the carousel advances to the
               last slide and stalls there for good, which reads as broken.
               A shopper interacting still stops it permanently, and
               prefers-reduced-motion disables it entirely. #}
            {% if component.autoplay %}auto-play loop auto-play-delay="{{ component.autoplay_speed|default('5000') }}"{% endif %}
            show-controls
            controls-outer
            static-when-single
            card-button
            source-label="home.slider"></falak-products-slider>

        {# The view-all sits centred UNDER the carousel. The component's own
           display-all-url puts it in the head beside the title, a different
           parent CSS cannot move it out of, so it is rendered here instead.
           The link is derived, not typed: the listing filtered and ordered to
           match the source. `show_all` is null on sections saved before the
           switch existed; those show it.

           It starts hidden: only the slider knows how many products match, so
           app.js reveals it once `fetched` reports more than data-view-all-min
           — with eight or fewer there is nothing more behind the link. #}
        {% if component.show_all ?? true %}
            <div class="products-slider__all" data-view-all-min="8" hidden>
                <a href="/products{{ {category: '?category_id%5B%5D=' ~ component.category, sales: '?sort=best_selling', 'top-rated': '?sort=top_rated', offers: '?on_offer=1'}[source] ?? '' }}">
                    {{ trans('common.view_all') }}
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19.5 12h-15m0 0 6.75 6.75M4.5 12l6.75-6.75"></path>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</section>
