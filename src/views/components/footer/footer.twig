{# Site footer — statically included from master.twig via {% component 'footer.footer' %} #}
<footer class="site-footer{{ theme.settings.get('footer_is_dark') ? ' site-footer--dark' : '' }}">
    <div class="container">
        <div class="site-footer__inner">
            <div class="site-footer__brand">
                {% if store.logo %}
                    <img src="{{ store.logo }}" alt="{{ store.name }}" width="48" height="48">
                {% endif %}
                <span class="site-footer__brand-name">{{ store.name }}</span>
                {% if theme.settings.get('footer_about') %}
                    <p class="site-footer__about">{{ theme.settings.get('footer_about') }}</p>
                {% endif %}
            </div>

            <nav class="site-footer__menu" aria-label="{{ trans('footer.links') }}">
                <ul>
                    {% for item in menus.footer_menu|default([]) %}
                        <li><a href="{{ item.url }}"{{ item.is_new_tab ? ' target="_blank" rel="noopener"' : '' }}>{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            </nav>

            {# Social accounts — set per-store in the customizer (social group);
               each icon renders only when its URL is filled in. #}
            <div class="social-links" aria-label="{{ trans('footer.follow_us') }}">
                {% if theme.settings.get('social_instagram') %}
                    <a href="{{ theme.settings.get('social_instagram') }}" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none"/></svg>
                    </a>
                {% endif %}
                {% if theme.settings.get('social_x') %}
                    <a href="{{ theme.settings.get('social_x') }}" target="_blank" rel="noopener" aria-label="X">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.7 3h2.9l-6.4 7.3L21.7 21h-5.9l-4.6-6-5.3 6H3l6.8-7.8L3.1 3H9l4.2 5.5L17.7 3zm-1 16.2h1.6L7.9 4.7H6.2l10.5 14.5z"/></svg>
                    </a>
                {% endif %}
                {% if theme.settings.get('social_tiktok') %}
                    <a href="{{ theme.settings.get('social_tiktok') }}" target="_blank" rel="noopener" aria-label="TikTok">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.4 2.1 1.8 3.6 3.9 3.9v3c-1.5 0-2.8-.5-3.9-1.3v6.4a5.9 5.9 0 1 1-5.9-5.9c.3 0 .7 0 1 .1v3.1a2.9 2.9 0 1 0 1.9 2.7V3h3z"/></svg>
                    </a>
                {% endif %}
                {% if theme.settings.get('social_snapchat') %}
                    <a href="{{ theme.settings.get('social_snapchat') }}" target="_blank" rel="noopener" aria-label="Snapchat">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3c3 0 5 2.2 5 5v2c.8.4 1.8.3 2.5.1-.2 1-1.2 1.7-2.2 2 .8 1.6 2.2 2.6 3.7 2.9-.4.8-1.6 1.3-2.8 1.4-.2.6-.3 1-.6 1-.6.2-1.6-.3-2.6.2-.9.4-1.5 1.4-3 1.4s-2.1-1-3-1.4c-1-.4-2 0-2.6-.2-.3-.1-.4-.5-.6-1-1.2-.1-2.4-.6-2.8-1.4 1.5-.3 2.9-1.3 3.7-2.9-1-.3-2-1-2.2-2 .7.2 1.7.3 2.5-.1V8c0-2.8 2-5 5-5z"/></svg>
                    </a>
                {% endif %}
                {% if theme.settings.get('social_youtube') %}
                    <a href="{{ theme.settings.get('social_youtube') }}" target="_blank" rel="noopener" aria-label="YouTube">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15.2V8.8L15.5 12 10 15.2z"/></svg>
                    </a>
                {% endif %}
                {% if theme.settings.get('social_whatsapp') %}
                    <a href="{{ theme.settings.get('social_whatsapp') }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5A9.5 9.5 0 0 0 3.8 16.7L2.5 21.5l4.9-1.3A9.5 9.5 0 1 0 12 2.5zm0 17.3c-1.6 0-3.1-.5-4.4-1.3l-.3-.2-2.9.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.8zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.8.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2 0-.2 0-.3-.1-.4l-.7-1.8c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.9.9-1.1 2.2-.2 3.9 1.2 2.1 3 3.7 5.3 4.5 1.5.6 2.7.5 3.5-.3.3-.3.6-1 .4-1.5-.1-.3-.3-.3-.6-.5z"/></svg>
                    </a>
                {% endif %}
            </div>
        </div>

        {% if store.settings.show_copyright %}
            <p class="site-footer__copyright">{{ trans('footer.powered_by') }}</p>
        {% endif %}
    </div>
</footer>
