{#
    The article index.

    A SHELL. <custom-falak-blog-list> reads GET /api/storefront/blogs — the
    endpoint that already owns the published scope and the tag / category /
    search filters — so the controller queries nothing and no copy of those
    rules lives in this theme.

    Filters are read from this page's own query string by the element, so
    /blogs?tag=x stays a real, shareable URL.
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('blog.title') }} — {{ store.name }}{% endblock %}

{% block content %}
    <div class="container blog-index">
        <header class="page-head">
            <h1>{{ trans('blog.title') }}</h1>
        </header>

        <custom-falak-blog-list per-page="24"></custom-falak-blog-list>
    </div>
{% endblock %}
