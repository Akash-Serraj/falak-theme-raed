{#
    Single order.
    | Variable | Type   | Description                                                     |
    | order    | ?array | number, status, created_at, items[], subtotal, shipping, total  |
    |          |        | items[]: name, quantity, price, image, url                      |
#}
{% extends "layouts.customer" %}

{% set account_page = 'orders' %}

{% block title %}{{ trans('account.order') }} #{{ order.number|default('') }} — {{ store.name }}{% endblock %}

{% block account_content %}
    {% if order|default(null) %}
        {# The SDK order summary: fetches the live status + timeline for the
           signed-in customer; the server-rendered order inside shows first. #}
        <falak-order-summary order-number="{{ order.number }}" order="{{ order|json_encode|escape('html_attr') }}">
        <header class="order-head">
            <h1>{{ trans('account.order') }} #{{ order.number }}</h1>
            <span class="order-status order-status--{{ order.status }}">{{ trans('account.status.' ~ order.status) }}</span>
        </header>
        <p class="order-head__date">{{ order.created_at|date('Y/m/d') }}</p>
        {% if order.address|default(null) and order.address.address|default(null) %}
            <p class="order-head__address">
                <strong>{{ trans('checkout.deliver_to') }}:</strong>
                {{ order.address.name|default('') }} — {{ order.address.address }}, {{ order.address.city|default('') }} {{ order.address.country|default('') }}
            </p>
        {% endif %}

        <ul class="cart-items">
            {% for item in order.items|default([]) %}
                <li class="cart-item">
                    {% if item.image %}<img src="{{ item.image }}" alt="{{ item.name }}">{% endif %}
                    <div class="cart-item__info">
                        {% if item.url %}
                            <a href="{{ item.url }}">{{ item.name }}</a>
                        {% else %}
                            <span>{{ item.name }}</span>
                        {% endif %}
                        <span class="cart-item__meta">{{ item.quantity }} × {{ falak_currency(item.price) }}</span>
                    </div>
                </li>
            {% endfor %}
        </ul>

        <div class="order-totals">
            <div class="cart-summary__row">
                <span>{{ trans('cart.subtotal') }}</span>
                <span>{{ falak_currency(order.subtotal|default(0)) }}</span>
            </div>
            {% if order.discount|default(0) > 0 %}
                <div class="cart-summary__row cart-summary__row--discount">
                    <span>{{ trans('cart.discount') }}</span>
                    <span>&minus; {{ falak_currency(order.discount) }}</span>
                </div>
            {% endif %}
            {% if order.shipping|default(0) > 0 %}
                <div class="cart-summary__row">
                    <span>{{ trans('account.shipping') }}</span>
                    <span>{{ falak_currency(order.shipping) }}</span>
                </div>
            {% endif %}
            {% if order.cod_fee|default(0) > 0 %}
                <div class="cart-summary__row">
                    <span>{{ trans('checkout.cod_fee') }}</span>
                    <span>{{ falak_currency(order.cod_fee) }}</span>
                </div>
            {% endif %}
            {% if order.tax|default(0) > 0 %}
                <div class="cart-summary__row">
                    <span>{{ trans('checkout.tax') }}</span>
                    <span>{{ falak_currency(order.tax) }}</span>
                </div>
            {% endif %}
            <div class="cart-summary__row cart-summary__row--total">
                <span>{{ trans('cart.total') }}</span>
                <span>{{ falak_currency(order.total|default(0)) }}</span>
            </div>
        </div>
        </falak-order-summary>
    {% else %}
        <falak-placeholder icon="📦" text="{{ trans('account.order_not_found') }}"
                           action-text="{{ trans('account.orders') }}" action-href="/customer/orders"
                           action-class="btn btn--outline"></falak-placeholder>
    {% endif %}
{% endblock %}
