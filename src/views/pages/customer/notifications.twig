{#
    Customer notifications.
    | Variable      | Type  | Description                                     |
    | notifications | array | each: title, body, created_at, is_read, url     |
#}
{% extends "layouts.customer" %}

{% set account_page = 'notifications' %}

{% block title %}{{ trans('account.notifications') }} — {{ store.name }}{% endblock %}

{% block account_content %}
    <h1>{{ trans('account.notifications') }}</h1>

    {% if notifications|default([])|length > 0 %}
        <ul class="notification-list">
            {% for item in notifications %}
                <li>
                    <falak-notification-item
                        title="{{ item.title }}"
                        body="{{ item.body|default('') }}"
                        url="{{ item.url|default('') }}"
                        created-at="{{ item.created_at }}"
                        {{ item.is_read|default(false) ? '' : 'unread' }}></falak-notification-item>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <falak-placeholder icon="🔔" text="{{ trans('account.no_notifications') }}"></falak-placeholder>
    {% endif %}
{% endblock %}
