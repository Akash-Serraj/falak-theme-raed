{#
    Product card — shared by listing, search, brand and wishlist pages.
    Expects `product`: id, name, price (formatted), image, url.
    The name link stretches over the card; the buy button sits above it.
#}
<div class="product-card">
    <span class="product-card__media">
        {% if product.image %}
            <img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy">
        {% else %}
            <span class="product-card__placeholder" aria-hidden="true">🛍</span>
        {% endif %}
    </span>

    <h3><a class="product-card__link" href="{{ product.url }}">{{ product.name }}</a></h3>
    <p class="product-card__price">{{ product.price }}</p>

    {# The SDK's add button performs the add itself (guest or customer) and
       reports success/failure; button-class keeps this card's skin, and the
       stretched name link stays underneath (.product-card .btn--card is
       z-indexed above it). Definedness test on in_stock — `|default(true)`
       would turn an explicit false back into true. #}
    <falak-add-product-button product-id="{{ product.id }}"
                              product-status="{{ (product.in_stock is defined and not product.in_stock) ? 'out' : 'sale' }}"
                              {{ product.has_variations|default(false) ? 'has-options' : '' }}
                              product-name="{{ product.name }}"
                              product-image="{{ product.image }}"
                              product-price="{{ product.price }}"
                              quantity-selector=""
                              button-class="btn btn--card"
                              source="listing"></falak-add-product-button>
    {# The heart, beside the buy button — guest or customer. #}
    <falak-wishlist-button product-id="{{ product.id }}" button-class="btn btn--card btn--card-icon"></falak-wishlist-button>
</div>
