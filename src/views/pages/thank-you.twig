{#
    Post-checkout confirmation.
    | Variable | Type   | Description                                                                 |
    | order    | ?array | number, total, payment_method, payment_method_name, payment_status, address, items[], url |
#}
{% extends "layouts.master" %}

{% block title %}{{ trans('thank_you.title') }} — {{ store.name }}{% endblock %}

{% block content %}
    <div class="container thank-you">
        <section class="thank-you__hero">
            <div class="thank-you__icon" aria-hidden="true">✓</div>
            <h1>{{ trans('thank_you.title') }}</h1>
            <p>{{ trans('thank_you.message') }}</p>

            {% if order|default(null) %}
                <p class="thank-you__order">
                    <span class="thank-you__pill">
                        <span class="thank-you__pill-label">{{ trans('account.order') }}</span>
                        <b dir="ltr">#{{ order.number }}</b>
                        <button type="button" class="thank-you__copy" data-copy="{{ order.number }}"
                                aria-label="{{ trans('thank_you.copy_number') }}" title="{{ trans('thank_you.copy_number') }}"
                                onclick="if (navigator.clipboard) { navigator.clipboard.writeText(this.dataset.copy); } this.classList.add('is-copied'); var b = this; setTimeout(function () { b.classList.remove('is-copied'); }, 1500);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                            <span class="thank-you__copied">{{ trans('thank_you.copied') }}</span>
                        </button>
                    </span>
                    <span class="thank-you__total">{{ order.display_total is defined and order.display_total is not null ? falak_currency(order.display_total, order.display_currency, false) : falak_currency(order.total|default(0)) }}</span>
                </p>
                {% if order.address.email|default(null) %}
                    <p class="thank-you__sent">{{ trans('thank_you.confirmation_sent', {email: order.address.email}) }}</p>
                {% endif %}
            {% endif %}
        </section>

        {% if order|default(null) %}
            <div class="thank-you__grid">
                <section class="thank-you__card">
                    <h2 class="thank-you__card-title">{{ trans('checkout.order_details') }}</h2>
                    {# Items + totals only; the order page shows the timeline and address. #}
                    <falak-order-summary compact order="{{ order|json_encode|escape('html_attr') }}">
                        {% if order.items|default([])|length > 0 %}
                            <ul class="thank-you__items">
                                {% for item in order.items %}
                                    <li>
                                        {% if item.image %}<img src="{{ item.image }}" alt="">{% endif %}
                                        <span class="thank-you__item-name">{{ item.name }}</span>
                                        <span class="thank-you__item-qty">× {{ item.quantity }}</span>
                                        <span class="thank-you__item-total">{{ falak_currency(item.total) }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </falak-order-summary>
                </section>

                <aside class="thank-you__aside">
                    {% set address = order.address|default(null) %}
                    {% if address and (address.name|default(null) or address.address|default(null)) %}
                        <section class="thank-you__card">
                            <h2 class="thank-you__card-title">{{ trans('checkout.deliver_to') }}</h2>
                            <p class="thank-you__card-text">
                                {% if address.name|default(null) %}<strong>{{ address.name }}</strong><br>{% endif %}
                                {% if address.address|default(null) %}{{ address.address }}{% if address.district|default(null) %}, {{ address.district }}{% endif %}<br>{% endif %}
                                {% if address.city|default(null) %}{{ address.city }}{% if address.country|default(null) %}, {{ address.country }}{% endif %}{% elseif address.country|default(null) %}{{ address.country }}{% endif %}
                                {% if address.phone|default(null) %}<br><span dir="ltr">{{ address.phone }}</span>{% endif %}
                            </p>
                        </section>
                    {% endif %}

                    <section class="thank-you__card">
                        <h2 class="thank-you__card-title">{{ trans('account.payment') }}</h2>
                        {% set methodKey = 'account.payment_method.' ~ order.payment_method|default('') %}
                        {% set methodLabel = trans(methodKey) %}
                        {% set payStatus = order.payment_status|default('pending') %}
                        <dl class="thank-you__facts">
                            <div>
                                <dt>{{ trans('account.payment_method_label') }}</dt>
                                <dd>{{ order.payment_method_name|default(null) ?: (methodLabel != methodKey ? methodLabel : order.payment_method|default('')|upper) }}</dd>
                            </div>
                            <div>
                                <dt>{{ trans('checkout.payment_status') }}</dt>
                                <dd><span class="thank-you__status thank-you__status--{{ payStatus }}">{{ trans('account.payment_status.' ~ payStatus) }}</span></dd>
                            </div>
                        </dl>
                        {% if order.charged_currency|default(null) and order.charged_currency != order.display_currency|default(order.currency|default(null)) %}
                            <p class="thank-you__card-text thank-you__card-text--soft">{{ trans('thank_you.charged', {amount: falak_currency(order.charged_amount, order.charged_currency, false)}) }}</p>
                        {% endif %}
                    </section>

                    <section class="thank-you__card">
                        <h2 class="thank-you__card-title">{{ trans('thank_you.what_next') }}</h2>
                        <ol class="thank-you__steps">
                            <li>{{ trans('thank_you.next_processing') }}</li>
                            {# A download, a voucher, a service: nothing is shipped, so nothing is promised. #}
                            {% if order.requires_shipping|default(true) %}
                                <li>{{ trans('thank_you.next_shipping') }}</li>
                            {% endif %}
                            {% if order.payment_method == 'cash_on_delivery' %}
                                <li>{{ trans('thank_you.next_cod') }}</li>
                            {% endif %}
                        </ol>
                    </section>
                </aside>
            </div>
        {% endif %}

        <div class="thank-you__actions">
            {% if order|default(null) and order.url|default(null) %}
                <a class="btn btn--primary" href="{{ order.url }}">{{ trans('thank_you.view_order') }}</a>
            {% endif %}
            <a class="btn btn--outline" href="{{ store.url }}">{{ trans('checkout.continue_shopping') }}</a>
        </div>
    </div>
{% endblock %}
