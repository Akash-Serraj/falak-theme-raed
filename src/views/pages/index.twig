{#
    Home page — the body is a merchant-composed component area.
    `{% component home %}` (bare word) renders the components this store's merchant
    placed in area 'home', in merchant order, each with its own saved settings.
#}
{% extends "layouts.master" %}

{% block content %}
    {% component home %}
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'js/home.js'|asset }}?v=5"></script>
{% endblock %}
